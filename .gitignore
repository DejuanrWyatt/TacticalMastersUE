# Unreal build output and caches - none of this belongs in the repository.
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
*.sln
*.suo
*.VC.db
*.opendb
.vs/
build.log

# Downloaded content: large and always re-obtainable, so it is fetched rather
# than cloned. Anything derived from it -- retargeted meshes, materials, the
# class-to-character mapping -- is kept, because that is the actual work.
# Sparrow alone is 3 GB; the whole roster would make a repository nobody could
# clone. Docs/CharacterPipeline.md says where each piece comes from.
Content/Paragon*/
Content/Characters/Mannequins/
Content/Characters/Paragon/
!Content/Characters/Paragon/.gitkeep
